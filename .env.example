# Copy to .env.local for local development. See docs/ADMIN_SETUP.md.
# Without the Supabase values the site runs as before (Netlify Forms).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
# Phase 2 (optional): FreeAgent invoicing. FREEAGENT_ENV is sandbox or live.
FREEAGENT_CLIENT_ID=
FREEAGENT_CLIENT_SECRET=
FREEAGENT_ENV=sandbox
# Protects the morning check (/api/cron/daily).
CRON_SECRET=
# Sandbox only: the preview password.
SITE_PASSWORD=
